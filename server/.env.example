# ---- Backend (Express + Prisma) ----
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://alrajhi:alrajhi@localhost:5432/alrajhi?schema=public"

# Auth (use long random strings in production)
JWT_SECRET="change-this-access-secret-min-16-chars"
JWT_REFRESH_SECRET="change-this-refresh-secret-min-16-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

CLIENT_ORIGIN="http://localhost:3000"

# File uploads — local in dev; set Cloudinary in production
UPLOAD_DIR="uploads"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
